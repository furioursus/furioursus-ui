{
	"name": "@furioursus/ui",
	"version": "0.2.0",
	"description": "Design tokens, theme switching and Vue components shared across furioursus sites.",
	"type": "module",
	"repository": "github:furioursus/furioursus-ui",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"dist",
		"assets"
	],
	"exports": {
		"./tokens.css": "./dist/tokens.css",
		"./tailwind.css": "./dist/tailwind.css",
		"./base.css": "./dist/base.css",
		"./theme.js": "./dist/theme.js",
		"./tokens.json": "./dist/tokens.json",
		"./vue": "./dist/vue/index.js",
		"./vue/style.css": "./dist/vue/style.css",
		"./assets/*": "./assets/*",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "node scripts/build.mjs && vite build",
		"test": "node --test 'test/*.test.mjs' && vitest run"
	},
	"peerDependencies": {
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/test-utils": "^2.5.1",
		"jsdom": "^31.0.0",
		"vite": "^8.3.7",
		"vitest": "^5.1.0",
		"vue": "^3.5.45"
	}
}
